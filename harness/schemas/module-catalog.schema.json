{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-harness.local/schemas/module-catalog.schema.json",
  "title": "Cursor Harness Module Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "globalPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paths",
          "reason"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retention": {
      "description": "Destruction schedule for collected evidence. Evidence referenced by a current-diff receipt or the newest receipt per check is never deleted, so fresh receipts stay verifiable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceMaxAgeDays": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceMaxCount": {
          "type": "integer",
          "minimum": 1
        },
        "contextMaxCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contextPack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalChars": {
          "type": "integer",
          "minimum": 1
        },
        "fileChars": {
          "type": "integer",
          "minimum": 1
        },
        "diffChars": {
          "type": "integer",
          "minimum": 0
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "maxTrackedPaths": {
      "type": "integer",
      "minimum": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "paths",
          "dependsOn",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "root": {
            "type": "string"
          },
          "shared": {
            "type": "boolean"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "security": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "resilience": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "privacy": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "safety": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "reliability": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "availability": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "performance": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "maintainability": {
                "oneOf": [
                  {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "minimal",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tier"
                    ],
                    "properties": {
                      "tier": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "minimal",
                          "none"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          "forbiddenDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layer": {
            "type": "string"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimeValidityHours": {
      "type": "integer",
      "minimum": 1
    },
    "memory": {
      "description": "Project memory contract: where the ledger lives, how large it may grow before archiving, and the recap budget.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ledger": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": "string",
          "minLength": 1
        },
        "maxLedgerBytes": {
          "type": "integer",
          "minimum": 1000
        },
        "keepDone": {
          "type": "integer",
          "minimum": 1
        },
        "keepNotes": {
          "type": "integer",
          "minimum": 1
        },
        "recapBudget": {
          "type": "integer",
          "minimum": 500
        }
      }
    },
    "budget": {
      "description": "Blast-radius budget. Exceeding it is a signal to split the change or escalate deliberately; the assurance profile decides whether it warns or blocks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxChangedFiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxChangedLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxModulesTouched": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxNewFiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "review": {
      "description": "Structured review settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRounds": {
          "description": "FIX_REQUIRED verdicts before the review escalates to the user (default 3).",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
