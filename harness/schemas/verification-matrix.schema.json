{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-harness.local/schemas/verification-matrix.schema.json",
  "title": "Cursor Harness Verification Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "checks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "riskChecks": {
      "description": "Extra check IDs per task risk level. Levels are cumulative: a high-risk task also runs the low and medium lists.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "medium": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "high": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "command",
          "required"
        ],
        "properties": {
          "class": {
            "enum": [
              "format",
              "static",
              "test",
              "integration",
              "build",
              "diagnostic",
              "integrity",
              "security",
              "privacy",
              "runtime"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "attributes": {
            "type": "array",
            "items": {
              "enum": [
                "security",
                "resilience",
                "privacy",
                "safety",
                "reliability",
                "availability",
                "performance",
                "maintainability"
              ]
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "allowFastSkip": {
            "description": "Declared in advance: an open fast loan may defer this check and record the debt. Never honoured for a check that evidences security, safety, or privacy.",
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
