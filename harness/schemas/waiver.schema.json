{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-harness.local/schemas/waiver.schema.json",
  "title": "Cursor Harness Quality Waiver",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "reason",
    "scope",
    "expiry",
    "compensation",
    "created_at"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    },
    "compensation": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
