{
  "$schema": "./schemas/verification-matrix.schema.json",
  "version": 1,
  "riskChecks": {
    "high": [
      "manifest-check"
    ]
  },
  "checks": {
    "feedback-lint": {
      "class": "static",
      "command": "node scripts/harness.mjs feedback lint",
      "required": true,
      "attributes": [
        "maintainability"
      ]
    },
    "runtime-sync": {
      "class": "static",
      "command": "node scripts/harness.mjs validate --sync-only",
      "required": true,
      "attributes": [
        "security",
        "reliability"
      ]
    },
    "validate": {
      "class": "static",
      "command": "node scripts/harness.mjs validate",
      "required": true,
      "attributes": [
        "maintainability"
      ]
    },
    "doctor": {
      "class": "diagnostic",
      "command": "node scripts/harness.mjs doctor",
      "required": true,
      "attributes": [
        "reliability"
      ]
    },
    "node-test": {
      "class": "test",
      "command": "node --test",
      "required": true,
      "attributes": [
        "reliability",
        "security"
      ]
    },
    "manifest-check": {
      "class": "integrity",
      "command": "node scripts/harness.mjs manifest --check",
      "required": true,
      "attributes": [
        "security",
        "safety"
      ]
    },
    "catalog-lint": {
      "class": "static",
      "command": "node scripts/harness.mjs catalog lint",
      "required": true,
      "attributes": [
        "maintainability",
        "safety"
      ]
    },
    "arch-check": {
      "class": "static",
      "command": "node scripts/harness.mjs arch-check",
      "required": true,
      "attributes": [
        "maintainability",
        "security",
        "privacy"
      ]
    },
    "fitness": {
      "class": "static",
      "command": "node scripts/harness.mjs fitness --all",
      "required": true,
      "attributes": [
        "security",
        "privacy",
        "reliability",
        "resilience",
        "safety"
      ]
    },
    "adr-check": {
      "class": "static",
      "command": "node scripts/harness.mjs adr-check",
      "required": true,
      "attributes": [
        "maintainability",
        "safety"
      ]
    }
  }
}
