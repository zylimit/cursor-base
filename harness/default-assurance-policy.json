{
  "$schema": "./schemas/assurance-policy.schema.json",
  "version": 1,
  "default": "balanced",
  "maxLoanMinutes": 480,
  "profiles": {},
  "floors": {
    "risk": {
      "low": "rapid",
      "medium": "balanced",
      "high": "strict"
    },
    "impact": "balanced",
    "protectedAttributes": "strict",
    "criticalHighAttributes": "balanced",
    "paths": [
      {
        "id": "governance",
        "patterns": [
          ".cursor/hooks.json",
          ".cursor/cli.json",
          ".cursor/runtime/**",
          ".cursor/sandbox.json",
          "harness/**",
          "scripts/**",
          "setup.sh",
          "setup.ps1",
          ".github/**",
          "package.json",
          "package-lock.json",
          "pnpm-lock.yaml",
          "yarn.lock"
        ],
        "profile": "strict",
        "reason": "the executable harness or delivery surface changed"
      },
      {
        "id": "trust-boundary",
        "patterns": [
          "**/auth/**",
          "**/security/**",
          "**/secrets/**",
          "**/privacy/**"
        ],
        "profile": "strict",
        "reason": "an authentication, secret, security, or privacy path changed"
      }
    ]
  }
}
