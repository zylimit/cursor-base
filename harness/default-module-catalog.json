{
  "$schema": "./schemas/module-catalog.schema.json",
  "version": 1,
  "globalPaths": [
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "tsconfig.json",
    "go.mod",
    "go.sum",
    "Cargo.toml",
    "Cargo.lock",
    "pyproject.toml",
    "poetry.lock",
    "requirements.txt",
    ".gitignore",
    ".gitattributes"
  ],
  "ignored": [
    {
      "paths": [
        ".cursor/**",
        ".cursorignore",
        ".cursorindexingignore",
        "harness/**",
        "scripts/harness.mjs",
        "AGENTS.md",
        "FRAMEWORK-MANIFEST.json"
      ],
      "reason": "Harness assets; governed by validate and the manifest check rather than by impact."
    },
    {
      "paths": [
        "progress.md",
        "progress.archive.md",
        "README.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "docs/**"
      ],
      "reason": "Prose and project memory carry no executable behavior."
    }
  ],
  "modules": [
    {
      "id": "app",
      "paths": [
        "src/**"
      ],
      "dependsOn": [],
      "verification": [],
      "owners": []
    }
  ]
}
