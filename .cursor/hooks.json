{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/scripts/hook-adapter.mjs sessionStart",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/scripts/hook-adapter.mjs subagentStart",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/scripts/hook-adapter.mjs subagentStop",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/scripts/hook-adapter.mjs beforeReadFile",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/scripts/hook-adapter.mjs beforeShellExecution",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
