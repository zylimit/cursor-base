{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/runtime/harness.mjs hook beforeShellExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/runtime/harness.mjs hook beforeMCPExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/runtime/harness.mjs hook beforeReadFile",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/runtime/harness.mjs hook preToolUse",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/runtime/harness.mjs hook afterFileEdit",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/runtime/harness.mjs hook afterShellExecution",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/runtime/harness.mjs hook postToolUse",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/runtime/harness.mjs hook subagentStart",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/runtime/harness.mjs hook preCompact",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/runtime/harness.mjs hook subagentStop",
        "timeout": 10,
        "loop_limit": 1
      }
    ],
    "stop": [
      {
        "command": "node .cursor/runtime/harness.mjs hook stop",
        "timeout": 15,
        "loop_limit": 2
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/runtime/harness.mjs hook sessionStart",
        "timeout": 15
      }
    ]
  }
}
