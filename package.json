{
  "name": "cursor-repository-harness",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zylimit/cursor-base.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/harness.mjs manifest --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "runtime-sync": "node scripts/harness.mjs validate --sync-only",
    "test": "node scripts/harness.mjs test",
    "test:mutation": "node --test tests/guard-mutations.mjs",
    "doctor": "node scripts/harness.mjs doctor",
    "validate": "node scripts/harness.mjs validate",
    "manifest:write": "node scripts/harness.mjs manifest --write",
    "manifest:check": "node scripts/harness.mjs manifest --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  }
}
